# ─────────────────────────────────────────────────────────────────────
# Template for the ingestor's environment. Copy to .env and fill in real
# values:
#
#     cp .env.example .env      # then edit .env
#
# ─────────────────────────────────────────────────────────────────────

# PostgreSQL superuser — created when the data volume is first initialised.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-superuser
POSTGRES_DB=showertrack
TZ=Europe/Zurich

# Application DB role the ingestor connects as (created by initdb on first run).
APP_DB_PASSWORD=change-me-app-db-password

# MQTT broker the ingestor subscribes to.
MQTT_HOST=192.168.1.20
MQTT_PORT=1883
MQTT_USERNAME=ingestor
MQTT_PASSWORD=change-me-mqtt-password

# MQTT topic filters (device_id comes from the '+' wildcard).
MQTT_TOPIC_TELEMETRY=shower/+/telemetry
MQTT_TOPIC_EVENT=shower/+/event
MQTT_TOPIC_STATUS=shower/+/status

# Where the ingestor reaches Postgres (service name on the compose network).
PGHOST=postgres
PGPORT=5432
PGDATABASE=showertrack
PGUSER=showertrack_app
